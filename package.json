{
  "name": "jogo-coringa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm -r smoke",
    "check": "pnpm lint && pnpm typecheck && pnpm -r test:coverage && pnpm smoke",
    "sim": "node packages/sim/src/cli/sim.ts",
    "sim:calibrate": "node packages/sim/src/cli/calibrate.ts",
    "sim:dificil": "node packages/sim/src/cli/hard-gate.ts",
    "sim:tutorial": "node packages/sim/src/cli/tutorial-seed.ts",
    "play": "node packages/sim/src/cli/play.ts",
    "bot": "node packages/sim/src/cli/bot.ts",
    "dev:server": "pnpm --filter @coringa/server dev",
    "dev:web": "pnpm --filter @coringa/web dev",
    "e2e": "pnpm --filter @coringa/web e2e",
    "deploy:server": "pnpm check && pnpm --filter @coringa/server run deploy",
    "sim:replay": "node packages/sim/src/cli/replay.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "if [ -f scripts/check-fast.ts ]; then node scripts/check-fast.ts; else pnpm check; fi",
    "pre-push": "pnpm check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
