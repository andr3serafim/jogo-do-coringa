{
  "name": "jogo-coringa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "smoke": "pnpm -r smoke",
    "check": "pnpm lint && pnpm typecheck && pnpm -r test:coverage && pnpm smoke",
    "sim": "node packages/sim/src/cli/sim.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check",
    "pre-push": "pnpm check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
