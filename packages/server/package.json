{
  "name": "@coringa/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test": "vitest run && vitest run -c vitest.worker.config.ts",
    "test:coverage": "vitest run --coverage && vitest run -c vitest.worker.config.ts",
    "smoke": "node scripts/smoke.ts && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@coringa/engine": "workspace:*",
    "@coringa/protocol": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
